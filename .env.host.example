# Host-local Java development configuration.
# Use with scripts/start-local.sh.
#
# Docker runs only infrastructure:
# - Postgres on localhost:5433
# - MinIO on localhost:9000
# - embedding-service on localhost:8000
#
# Java services run on the host via Maven, reusing your local ~/.m2 cache.

POSTGRES_USER=vectorsync
POSTGRES_PASSWORD=vectorsync123
POSTGRES_DB=vectorsync

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/vectorsync
SPRING_DATASOURCE_USERNAME=vectorsync
SPRING_DATASOURCE_PASSWORD=vectorsync123

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

CONTROL_API_URL=http://localhost:8080

ICEBERG_CATALOG_WAREHOUSE=s3a://vectorsync/warehouse
ICEBERG_VECTOR_NAMESPACE=vectorsync

AWS_S3_ENDPOINT=http://localhost:9000
AWS_S3_ACCESS_KEY=minioadmin
AWS_S3_SECRET_KEY=minioadmin123
AWS_S3_PATH_STYLE_ACCESS=true
AWS_REGION=us-east-1

EMBEDDING_PROVIDER=external
EMBEDDING_EXTERNAL_TYPE=http
EMBEDDING_EXTERNAL_API_URL=http://localhost:8000/api/v1/embed-query
EMBEDDING_EXTERNAL_API_KEY=not-required
EMBEDDING_EXTERNAL_MODEL=all-MiniLM-L6-v2
EMBEDDING_EXTERNAL_HTTP_REQUEST_TEMPLATE={"text":"__TEXT__","model_name":"all-MiniLM-L6-v2","provider":"self_hosted"}
EMBEDDING_EXTERNAL_HTTP_RESPONSE_JSON_POINTER=/embedding
