# Service Configuration
SERVICE_NAME=vectorsync-embedding-service
SERVICE_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Provider Configuration
DEFAULT_PROVIDER=self_hosted
DEFAULT_MODEL=all-MiniLM-L6-v2

# Self-Hosted Provider Settings
SELF_HOSTED_DEVICE=cpu
SELF_HOSTED_MAX_WORKERS=4

# Managed Provider Settings (OpenAI, Gemini, etc.)
MANAGED_API_URL=https://api.openai.com/v1
MANAGED_API_KEY=your-api-key-here
MANAGED_MAX_CONCURRENT=10
MANAGED_TIMEOUT=30.0
MANAGED_MAX_RETRIES=3

# Batching Configuration
MAX_BATCH_SIZE=64
ENABLE_TOKEN_BATCHING=false

# Performance Settings
ENABLE_REQUEST_LOGGING=true
ENABLE_METRICS=true