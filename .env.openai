# ============================================
# OPENAI SAAS CONFIGURATION
# ============================================
# This configuration uses:
# - External S3 (AWS/IBM Cloud Object Storage)
# - OpenAI API for embeddings
# - No local MinIO or embedding service needed
#
# Usage: docker-compose up -d
# (No profiles needed - only core services will start)

# PostgreSQL Configuration
POSTGRES_USER=vectorsync
POSTGRES_PASSWORD=vectorsync123
POSTGRES_DB=vectorsync
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/vectorsync
SPRING_DATASOURCE_USERNAME=vectorsync
SPRING_DATASOURCE_PASSWORD=vectorsync123

# External S3 Configuration (AWS S3 or IBM COS)
# Replace with your actual S3 endpoint and credentials
AWS_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
AWS_S3_ACCESS_KEY=YOUR_AWS_ACCESS_KEY
AWS_S3_SECRET_KEY=YOUR_AWS_SECRET_KEY
AWS_S3_PATH_STYLE_ACCESS=false
AWS_REGION=us-east-1

# Iceberg Configuration
ICEBERG_CATALOG_WAREHOUSE=s3a://your-bucket-name/warehouse
ICEBERG_VECTOR_NAMESPACE=vectorsync

# Control API Configuration
CONTROL_API_URL=http://control-plane:8080

# Embedding Configuration - OpenAI API
EMBEDDING_PROVIDER=external
EMBEDDING_EXTERNAL_TYPE=http
EMBEDDING_EXTERNAL_API_URL=https://api.openai.com/v1/embeddings
EMBEDDING_EXTERNAL_API_KEY=YOUR_OPENAI_API_KEY
EMBEDDING_EXTERNAL_MODEL=text-embedding-3-small
EMBEDDING_EXTERNAL_REQUEST_TEMPLATE={"input":"${text}","model":"text-embedding-3-small"}
EMBEDDING_EXTERNAL_RESPONSE_JSON_POINTER=/data/0/embedding

# Note: OpenAI text-embedding-3-small produces 1536-dimensional vectors
# You'll need to update Constants.EMBEDDING_DIMENSION to 1536 if using this model
