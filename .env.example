POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vectorsync

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/vectorsync
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me

CONTROL_API_URL=http://control-plane:8080
ICEBERG_CATALOG_WAREHOUSE=s3a://vectorsync-warehouse/
ICEBERG_VECTOR_NAMESPACE=vector

AWS_S3_ENDPOINT=http://minio:9000
AWS_S3_ACCESS_KEY=minioadmin
AWS_S3_SECRET_KEY=change-me
AWS_S3_PATH_STYLE_ACCESS=true
AWS_REGION=us-east-1

EMBEDDING_PROVIDER=external
EMBEDDING_EXTERNAL_TYPE=http
EMBEDDING_EXTERNAL_API_URL=http://embedding-service:8000/api/v1/embed-query
EMBEDDING_EXTERNAL_API_KEY=not-required
EMBEDDING_EXTERNAL_MODEL=all-MiniLM-L6-v2
EMBEDDING_EXTERNAL_HTTP_REQUEST_TEMPLATE={"text":"__TEXT__","model_name":"all-MiniLM-L6-v2","provider":"self_hosted"}
EMBEDDING_EXTERNAL_HTTP_RESPONSE_JSON_POINTER=/embedding
