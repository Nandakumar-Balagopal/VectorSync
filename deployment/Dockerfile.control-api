FROM maven:3.9.9-eclipse-temurin-17 AS builder
WORKDIR /app
COPY . .
RUN mvn clean package -DskipTests -pl control-api -am

FROM eclipse-temurin:17-jre-jammy
WORKDIR /app
COPY --from=builder /app/control-api/target/vectorsync-control-api-*.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
