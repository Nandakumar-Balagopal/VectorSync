FROM maven:3.9.9-eclipse-temurin-17 AS builder
WORKDIR /app
COPY . .
RUN mvn clean package -DskipTests -pl search-api -am

FROM eclipse-temurin:17-jre-jammy
WORKDIR /app
COPY --from=builder /app/search-api/target/vectorsync-search-api-*.jar app.jar
EXPOSE 8082
ENTRYPOINT ["java", "-jar", "app.jar"]
