FROM maven:3.9.9-eclipse-temurin-17 AS builder
WORKDIR /app
COPY . .
RUN mvn clean package -DskipTests -pl control-plane -am

FROM eclipse-temurin:17-jre-jammy
WORKDIR /app
COPY --from=builder /app/control-plane/target/vectorsync-control-plane-*.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]

