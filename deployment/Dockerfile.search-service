FROM maven:3.9.9-eclipse-temurin-17 AS builder
WORKDIR /app
COPY pom.xml .
COPY common/pom.xml common/pom.xml
COPY vectorsync-format/pom.xml vectorsync-format/pom.xml
COPY control-plane/pom.xml control-plane/pom.xml
COPY worker/pom.xml worker/pom.xml
COPY search-service/pom.xml search-service/pom.xml
RUN mvn -q -B -Dmaven.wagon.http.retryHandler.count=5 -Dmaven.wagon.httpconnectionManager.ttlSeconds=120 -Dmaven.wagon.rto=60000 -DskipTests -pl search-service -am dependency:go-offline
COPY . .
RUN mvn -q -B -Dmaven.wagon.http.retryHandler.count=5 -Dmaven.wagon.httpconnectionManager.ttlSeconds=120 -Dmaven.wagon.rto=60000 -DskipTests -pl search-service -am package

FROM eclipse-temurin:17-jre-jammy
WORKDIR /app
COPY --from=builder /app/search-service/target/vectorsync-search-service-*.jar app.jar
EXPOSE 8083
# An OOM must kill the process, not leave a wedged JVM that a TCP healthcheck still reports as
# live. MaxRAMPercentage sizes the heap from the container limit rather than from the host, which
# is what makes a cgroup memory limit meaningful.
ENV JAVA_OPTS="-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/tmp"
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar app.jar"]
