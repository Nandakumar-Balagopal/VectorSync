# ============================================
# HYBRID CONFIGURATION
# ============================================
# This configuration uses:
# - Local MinIO for S3 storage
# - External SaaS API for embeddings (e.g., OpenAI, Gemini)
# - Mix of local and cloud services
#
# Usage: docker-compose --profile local-storage up -d

# PostgreSQL Configuration
POSTGRES_USER=vectorsync
POSTGRES_PASSWORD=vectorsync123
POSTGRES_DB=vectorsync
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/vectorsync
SPRING_DATASOURCE_USERNAME=vectorsync
SPRING_DATASOURCE_PASSWORD=vectorsync123

# MinIO Configuration (Local S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
AWS_S3_ENDPOINT=http://minio:9000
AWS_S3_ACCESS_KEY=minioadmin
AWS_S3_SECRET_KEY=minioadmin123
AWS_S3_PATH_STYLE_ACCESS=true
AWS_REGION=us-east-1

# Iceberg Configuration
ICEBERG_CATALOG_WAREHOUSE=s3a://vectorsync/warehouse
ICEBERG_VECTOR_NAMESPACE=vectorsync

# Control API Configuration
CONTROL_API_URL=http://control-plane:8080

# Embedding Configuration - External SaaS API
# Example: OpenAI (replace with your preferred provider)
EMBEDDING_PROVIDER=external
EMBEDDING_EXTERNAL_TYPE=http
EMBEDDING_EXTERNAL_API_URL=https://api.openai.com/v1/embeddings
EMBEDDING_EXTERNAL_API_KEY=YOUR_OPENAI_API_KEY
EMBEDDING_EXTERNAL_MODEL=text-embedding-3-small
EMBEDDING_EXTERNAL_REQUEST_TEMPLATE={"input":"${text}","model":"text-embedding-3-small"}
EMBEDDING_EXTERNAL_RESPONSE_JSON_POINTER=/data/0/embedding

# Alternative: Google Gemini
# EMBEDDING_EXTERNAL_API_URL=https://generativelanguage.googleapis.com/v1beta/models/embedding-001:embedContent
# EMBEDDING_EXTERNAL_API_KEY=YOUR_GEMINI_API_KEY
# EMBEDDING_EXTERNAL_REQUEST_TEMPLATE={"content":{"parts":[{"text":"${text}"}]}}
# EMBEDDING_EXTERNAL_RESPONSE_JSON_POINTER=/embedding/values
